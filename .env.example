# CurryClub environment configuration
# Copy this file to .env and fill in the values

# Port to run the server on (default: 3001)
PORT=3001

# Path to the SQLite database file (default: ratings.db in project root)
# DB_PATH=/home/ubuntu/CurryClub/ratings.db

# Admin portal password — required to enable the admin portal
# Generate a strong random password, e.g.:
#   node --input-type=module -e "import{randomBytes}from'crypto';console.log(randomBytes(16).toString('hex'))"
ADMIN_PASSWORD=your_secure_password_here
